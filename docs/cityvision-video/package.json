{
  "name": "cityvision-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.509",
    "@remotion/google-fonts": "^4.0.509",
    "@remotion/media": "4.0.509",
    "@remotion/motion-blur": "4.0.509",
    "@remotion/tailwind-v4": "4.0.509",
    "@remotion/transitions": "4.0.509",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.509",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.509",
    "@remotion/eslint-config-flat": "4.0.509",
    "@remotion/renderer": "^4.0.509",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "globals": "^17.11.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lint": "eslint src scripts && tsc --noEmit",
    "qa": "node scripts/qa-stills.mjs",
    "vo:boundaries": "node scripts/media-duration.mjs public/voiceover-tr.mp3",
    "render:reel": "remotion render CityVision-Reels-Vertical out/GBSoft-CityVision-Reels-60sn.mp4 --codec=h264 --crf=17",
    "render:reel:sessiz": "remotion render CityVision-Reels-Vertical-Sessiz out/GBSoft-CityVision-Reels-60sn-Sessiz.mp4 --codec=h264 --crf=17",
    "render:reel:draft": "remotion render CityVision-Reels-Vertical-Sessiz out/draft.mp4 --codec=h264 --crf=30 --scale=0.5",
    "render:yatay": "remotion render CityVision-Tanitim-Yatay out/GBSoft-CityVision-Tanitim-90sn.mp4 --codec=h264 --crf=17",
    "upgrade": "remotion upgrade",
    "qa:promo": "node scripts/qa-promo.mjs",
    "sfx:promo": "python3 scripts/promo_sfx.py",
    "render:promo": "remotion render CityVision-Promo-EN out/CityVision-Promo-EN-Reel.mp4 --codec=h264 --crf=14 --image-format=png --audio-bitrate=320k --pixel-format=yuv420p",
    "vo:promo": "python3 scripts/vo.py promo",
    "render:promo:vo": "remotion render CityVision-Promo-EN-VO out/CityVision-Promo-EN-Reel-VO.mp4 --codec=h264 --crf=14 --image-format=png --audio-bitrate=320k --pixel-format=yuv420p",
    "sfx:howto": "python3 scripts/howto_sfx.py",
    "vo:howto": "python3 scripts/vo.py howto",
    "qa:howto": "QA_PROJECT=howto node scripts/qa-promo.mjs",
    "render:howto": "remotion render CityVision-HowItWorks out/CityVision-HowItWorks.mp4 --codec=h264 --crf=14 --image-format=png --audio-bitrate=320k --pixel-format=yuv420p",
    "vo:game": "python3 scripts/vo.py game",
    "sfx:game": "python3 scripts/game_sfx.py",
    "qa:game": "QA_PROJECT=game node scripts/qa-promo.mjs",
    "render:game": "remotion render CityVision-BeatTheDrone out/CityVision-BeatTheDrone.mp4 --codec=h264 --crf=14 --image-format=png --audio-bitrate=320k --pixel-format=yuv420p",
    "vo:eyes": "python3 scripts/vo.py eyes",
    "sfx:eyes": "python3 scripts/eyes_sfx.py",
    "qa:eyes": "QA_PROJECT=eyes node scripts/qa-promo.mjs",
    "render:eyes": "remotion render CityVision-DifferentEyes out/CityVision-DifferentEyes.mp4 --codec=h264 --crf=14 --image-format=png --audio-bitrate=320k --pixel-format=yuv420p",
    "stats:wrapped": "python3 scripts/wrapped_stats.py",
    "vo:wrapped": "python3 scripts/vo.py wrapped",
    "sfx:wrapped": "python3 scripts/wrapped_sfx.py",
    "qa:wrapped": "QA_PROJECT=wrapped node scripts/qa-promo.mjs",
    "render:wrapped": "remotion render CityVision-Wrapped out/CityVision-Wrapped.mp4 --codec=h264 --crf=14 --image-format=png --audio-bitrate=320k --pixel-format=yuv420p"
  },
  "sideEffects": [
    "*.css"
  ]
}
