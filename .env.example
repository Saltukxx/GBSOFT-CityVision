# Reserved for later cloud / edge settings
CITYVISION_DEVICE=
CITYVISION_MODEL=yolov8n.pt

# Hugging Face (https://huggingface.co/settings/tokens)
# Read token yeterli. Bu dosyayı .env olarak kopyala; .env git'e girmez.
HF_TOKEN=

# PostgreSQL + PostGIS (docker compose up -d db → host port 5435)
DATABASE_URL=postgresql://cityvision:cityvision@localhost:5435/cityvision

# Optional: protect mutating /api/* with header X-Api-Key (empty = open local pilot)
CITYVISION_API_KEY=

# Local object store root (evidence copies)
CITYVISION_OBJECT_STORE=

# Optional Redis (docker compose --profile redis up -d)
REDIS_URL=redis://localhost:6380/0

# Optional MinIO/S3 (docker compose --profile minio up -d)
# When CITYVISION_S3_ENDPOINT is set, evidence goes to the bucket instead of local FS.
CITYVISION_S3_ENDPOINT=
# CITYVISION_S3_ENDPOINT=http://127.0.0.1:9000
CITYVISION_S3_ACCESS_KEY=cityvision
CITYVISION_S3_SECRET_KEY=cityvisionsecret
CITYVISION_S3_BUCKET=cityvision
CITYVISION_S3_REGION=us-east-1

# JWT login (pilot passwords set by seed_backend / POST /api/auth/users)
CITYVISION_JWT_SECRET=dev-change-me-cityvision
CITYVISION_JWT_EXPIRE_MIN=720

# Evidence media (frames/crops/clips) is personal data. As soon as an API key
# or a JWT secret is set, /api/storage, /api/media and /api/runs/{id}/annotated
# require a credential or a signed URL. With neither set the API is fully open —
# acceptable for a laptop demo, never for a deployment.
CITYVISION_MEDIA_URL_TTL_SEC=3600

# Multi-city default + RBAC (auto = on when JWT or API key set)
CITYVISION_DEFAULT_CITY=erzurum
CITYVISION_RBAC=auto

# Edge / Memphis upload limits (video segments or zip run packages)
CITYVISION_EDGE_UPLOAD_DIR=
CITYVISION_EDGE_MAX_UPLOAD_MB=200
# Thin uploader lab agent
CITYVISION_API_BASE=http://127.0.0.1:8088
CITYVISION_EDGE_TOKEN=
CITYVISION_EDGE_WORK_DIR=outputs/edge_agent
# 1 = run jobs in-process (no Redis worker needed)
CITYVISION_JOB_INLINE=0

# Optional webhook on work_order_created
CITYVISION_WEBHOOK_URL=
